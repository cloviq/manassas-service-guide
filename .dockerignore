# Build context for backend/ and frontend/ images (repo root, so both can embed
# catalog/sources.json). Allowlist only; embeddings/ keeps its own context.
*
!catalog/sources.json
!backend/Cargo.toml
!backend/Cargo.lock
!backend/src/
!backend/src/**
!backend/migrations/
!backend/migrations/**
!frontend/
!frontend/**
frontend/node_modules
frontend/dist
frontend/*evidence*
**/*.env
**/.env*
